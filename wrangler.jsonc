// Cloudflare: Worker אחד שמגיש את האתר (dist/) ואת ה-API (/api/*), עם מסד נתונים D1.
// מסד הנתונים "hamishkan" נוצר בממשק של Cloudflare; הטבלאות נוצרות לבד בבקשה הראשונה (worker/schema.ts)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knesset",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hamishkan",
      "database_id": "c22588fb-c075-4f21-b5a7-d982d6411d49",
      "migrations_dir": "worker/migrations"
    }
  ],
  "observability": { "enabled": true }
}
